rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Kullanıcı okuyabilir/yazabilir
    match /users/{userId} {
      allow read, write: if request.auth != null;
      
      // Alt koleksiyonlar:
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null;
      }
    }
    
    // Global notifications
    match /notifications/{docId} {
      allow read, write: if request.auth != null;
    }
    
    // Events: herkes okuyabilir, giriş yapan herkes yazabilir
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Messages: giriş yapan herkes okuyabilir/yazabilir
    match /messages/{msgId} {
      allow read, write: if request.auth != null;
    }
    
    // Appointment requests: giriş yapan herkes okuyabilir/yazabilir
    match /appointmentRequests/{reqId} {
      allow read, write: if request.auth != null;
    }
  }
}
